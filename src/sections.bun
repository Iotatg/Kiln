// src/sections.bun — the page, section by section.
//
// The page is one argument in six moves: what Kiln is, what it holds, who runs
// on it, what it is made of, where it fits, and how to start. Each section is a
// band with its own ground, separated by a hairline rather than a gap.

import { iso_scene, iso_link } from './iso.bun'
import { page_esc, page_mark } from './page.bun'
import { content_capabilities, content_tables, content_products, content_industries, content_stats, content_logos, content_quote, content_ticker, content_domains } from './content.bun'

let NUMERIC = ["On hand", "Reorder", "Unit cost", "Records", "Conflicts", "Runs / 30d", "Hours saved", "Rows", "Weight"]

fn arrow() {
    return '<svg class="arrow" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">'
        + '<path d="M2 12L12 2M12 2H5M12 2v7" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>'
}

fn is_alert(text) {
    let value = text.lower()
    return value == "reorder" or value == "low" or value == "delayed" or value == "review" or value == "paused"
}

// ---------------------------------------------------------------- the hero

fn hero_scene() {
    let boxes = [
        { "x": 0.5, "y": 0.5, "z": 0, "w": 1.5, "d": 1.5, "h": 2.8, "tone": "wire", "id": "a" },
        { "x": 3.0, "y": 0.8, "z": 0, "w": 2.2, "d": 2.2, "h": 1.8, "fill": "#2222f5", "id": "b" },
        { "x": 6.0, "y": 0.5, "z": 0, "w": 1.0, "d": 1.0, "h": 1.2, "fill": "#f2c230", "id": "c" },
        { "x": 1.0, "y": 4.0, "z": 0, "w": 2.0, "d": 2.0, "h": 0.9, "fill": "#34343d", "id": "d" },
        { "x": 4.0, "y": 4.6, "z": 0, "w": 1.1, "d": 1.1, "h": 0.9, "fill": "#e8503a", "id": "e" },
        { "x": 6.4, "y": 4.2, "z": 0, "w": 1.1, "d": 1.1, "h": 0.5, "tone": "wire", "id": "f" }
    ]
    return iso_scene(boxes, {
        "w": 680,
        "h": 500,
        "scale": 46.0,
        "ox": 340,
        "oy": 128,
        "grid": { "x0": -0.4, "y0": -0.4, "x1": 7.6, "y1": 7.6, "step": 1 },
        "callouts": [
            { "x": 1.25, "y": 1.25, "z": 2.8, "dx": -92, "dy": -26, "text": "Inventory", "anchor": "end" },
            { "x": 4.1, "y": 1.9, "z": 1.8, "dx": 92, "dy": -44, "text": "Ledger" },
            { "x": 4.55, "y": 5.15, "z": 0.9, "dx": 86, "dy": 40, "text": "Orders" }
        ],
        "title": "An isometric diagram: a blue core box among wireframe and coloured boxes on a drafting grid"
    })
}

export fn sec_hero() {
    var out = '<section class="hero" id="top"><div class="wrap">'
    out = out + '<div class="hero-grid">'
    out = out + '<div class="hero-copy">'
    out = out + '<h1 class="display">Run the whole plant<br>from <em>one</em> system.</h1>'
    out = out + '<p class="lede">Kiln unifies inventory, procurement, production, fulfilment and finance into one model — for manufacturers, distributors and CPG brands that outgrew spreadsheets.</p>'
    out = out + '<div class="actions">'
    out = out + '<a class="btn btn-fill" href="#demo">Book a demo ' + arrow() + '</a>'
    out = out + '<a class="btn btn-line" href="#platform">See the platform</a>'
    out = out + '</div>'
    out = out + '<dl class="hero-facts">'
    out = out + '<div><dt>Live plants</dt><dd>3</dd></div>'
    out = out + '<div><dt>Records a day</dt><dd>2.4M</dd></div>'
    out = out + '<div><dt>First plant live</dt><dd>6 wks</dd></div>'
    out = out + '</dl>'
    out = out + '</div>'
    out = out + '<div class="hero-art">'
    out = out + hero_scene()
    out = out + '<div class="tag tag-b"><span class="dot"></span>3 plants · one ledger</div>'
    out = out + '</div>'
    out = out + '</div>'
    out = out + sec_chain()
    out = out + sec_ticker()
    out = out + '</div></section>'
    return out
}

fn sec_chain() {
    let domains = content_domains()
    var out = '<div class="chain">'
    var i = 0
    while i < len(domains) {
        let domain = domains[i]
        out = out + '<div class="chain-item">'
        out = out + '<span class="chain-name">' + domain["name"] + '</span>'
        out = out + '<span class="chain-line">' + domain["line"] + '</span>'
        out = out + '</div>'
        i = i + 1
    }
    out = out + '</div>'
    return out
}

fn sec_ticker() {
    let words = content_ticker()
    var out = '<div class="strip">'
    var i = 0
    while i < len(words) {
        out = out + '<span>' + words[i] + '</span>'
        i = i + 1
    }
    out = out + '</div>'
    return out
}

// ---------------------------------------------------------------- the board

fn panel_head(table, first) {
    var out = '<div class="panel-top">'
    out = out + '<div class="panel-title"><span class="panel-name">' + table["title"] + '</span>'
    out = out + '<span class="panel-meta">' + table["meta"] + '</span></div>'
    out = out + '<div class="panel-tools">'
    out = out + '<label class="search"><svg width="13" height="13" viewBox="0 0 14 14" aria-hidden="true">'
    out = out + '<circle cx="6" cy="6" r="4.2" fill="none" stroke="currentColor" stroke-width="1.3"/>'
    out = out + '<path d="M9.2 9.2L13 13" stroke="currentColor" stroke-width="1.3"/></svg>'
    out = out + '<input type="search" placeholder="Search records" aria-label="Search records in ' + table["title"] + '"'
    if first {
        out = out + ' data-search="' + table["title"] + '"'
    }
    out = out + '></label>'
    out = out + '<button class="chip" type="button" data-alert-filter aria-pressed="false">Needs attention</button>'
    out = out + '</div></div>'
    return out
}

fn panel_table(table, table_id) {
    let columns = table["columns"]
    let rows = table["rows"]
    var out = '<div class="table-wrap"><table class="grid-table" data-table="' + table_id + '"><thead><tr>'
    var i = 0
    while i < len(columns) {
        var cls = ''
        if NUMERIC.contains(columns[i]) {
            cls = ' class="num"'
        }
        out = out + '<th scope="col"' + cls + '>' + columns[i] + '</th>'
        i = i + 1
    }
    out = out + '</tr></thead><tbody>'
    var r = 0
    while r < len(rows) {
        let row = rows[r]
        var flag = ''
        var c = 0
        while c < len(row) {
            if row[c].starts_with("!") and is_alert(row[c].slice(1, len(row[c]))) {
                flag = ' data-alert="1"'
            }
            c = c + 1
        }
        var search = ''
        c = 0
        while c < len(row) {
            search = search + row[c].lower() + ' '
            c = c + 1
        }
        out = out + '<tr data-search="' + page_esc(search) + '"' + flag + '>'
        c = 0
        while c < len(row) {
            let cell = row[c]
            var cls = ''
            if NUMERIC.contains(columns[c]) {
                cls = ' class="num"'
            }
            if cell.starts_with("!") {
                let status = cell.slice(1, len(cell))
                var tone = "ok"
                if is_alert(status) {
                    tone = "warn"
                }
                if status.lower() == "paused" or status.lower() == "delayed" {
                    tone = "off"
                }
                out = out + '<td><span class="tag-status is-' + tone + '">' + status + '</span></td>'
            } else {
                out = out + '<td' + cls + '>' + page_esc(cell) + '</td>'
            }
            c = c + 1
        }
        out = out + '</tr>'
        r = r + 1
    }
    out = out + '</tbody></table></div>'
    return out
}

export fn sec_board() {
    let caps = content_capabilities()
    let tables = content_tables()
    var out = '<section class="board" id="platform"><div class="wrap">'
    out = out + '<div class="board-head">'
    out = out + '<h2 class="h2">Six moves, one record.</h2>'
    out = out + '<p class="board-note">Pick a move to see the records it governs. The tables below are the product, not a screenshot of it.</p>'
    out = out + '</div>'

    out = out + '<div class="cap-strip" role="tablist" aria-label="Capabilities">'
    var i = 0
    while i < len(caps) {
        let cap = caps[i]
        var cls = 'cap'
        var pressed = 'false'
        if i == 0 {
            cls = 'cap is-on'
            pressed = 'true'
        }
        out = out + '<button class="' + cls + '" role="tab" id="cap-' + cap["id"] + '" aria-controls="set-' + cap["table"] + '"'
        out = out + ' aria-selected="' + pressed + '" data-cap="' + cap["table"] + '">'
        out = out + '<span class="cap-name">' + cap["name"] + '</span>'
        out = out + '<span class="cap-line">' + cap["line"] + '</span>'
        out = out + '</button>'
        i = i + 1
    }
    out = out + '</div>'

    out = out + '<div class="panel">'
    var first = true
    i = 0
    while i < len(caps) {
        let cap = caps[i]
        let table = tables[cap["table"]]
        var hidden = ' hidden'
        if first {
            hidden = ''
        }
        out = out + '<div class="dataset" id="set-' + cap["table"] + '" data-dataset="' + cap["table"] + '" role="tabpanel"'
        out = out + ' aria-labelledby="cap-' + cap["id"] + '"' + hidden + '>'
        out = out + panel_head(table, first)
        out = out + panel_table(table, cap["table"])
        out = out + '</div>'
        first = false
        i = i + 1
    }
    out = out + '<div class="panel-foot"><span class="mono">Rendered by the server from one JSON document</span>'
    out = out + '<span class="mono">Showing <b data-count>12</b> of 1,284</span></div>'
    out = out + '</div></div></section>'
    return out
}

// ------------------------------------------------------------ the statement

export fn sec_statement() {
    var out = '<section class="statement"><div class="wrap">'
    out = out + '<p class="statement-h" data-reveal>ERP is broken.<br>'
    out = out + '<span class="muted">To fix it, we built the system the plant actually runs on.</span><br>'
    out = out + 'One model, from the purchase order to the truck.</p>'
    out = out + '</div></section>'
    return out
}

// ---------------------------------------------------------------- the trust

export fn sec_trust() {
    let logos = content_logos()
    let stats = content_stats()
    let quote = content_quote()
    var out = '<section class="trust"><div class="wrap">'
    out = out + '<div class="trust-top">'
    out = out + '<h2 class="h2">Trusted by the people<br>who run the floor.</h2>'
    out = out + '<p class="trust-note">Our customers save time, grow margin and expand faster — without adding headcount to keep the system honest.</p>'
    out = out + '</div>'

    out = out + '<div class="logos">'
    var i = 0
    while i < len(logos) {
        out = out + '<span class="logo logo-' + logos[i]["style"] + '">' + logos[i]["name"] + '</span>'
        i = i + 1
    }
    out = out + '</div>'

    out = out + '<div class="quote">'
    out = out + '<blockquote class="quote-text">' + quote["text"] + '</blockquote>'
    out = out + '<div class="quote-by"><span class="quote-name">' + quote["name"] + '</span>'
    out = out + '<span class="quote-role">' + quote["role"] + '</span></div>'
    out = out + '</div>'

    out = out + '<dl class="stats">'
    i = 0
    while i < len(stats) {
        out = out + '<div class="stat"><dt>' + stats[i]["label"] + '</dt><dd>' + stats[i]["value"] + '</dd></div>'
        i = i + 1
    }
    out = out + '</dl></div></section>'
    return out
}

// ------------------------------------------------------------- the products

fn product_diagram(kind, tone, dark) {
    var boxes = []
    var view = { "w": 540, "h": 470, "scale": 62.0, "ox": 270, "oy": 78 }
    var edge = "rgba(10,10,11,0.34)"
    if dark {
        edge = "rgba(239,237,230,0.42)"
    }
    if kind == "stack" {
        boxes = [
            { "x": 1.0, "y": 1.0, "z": 0, "w": 4.2, "d": 4.2, "h": 0.4, "tone": "wire", "edge": edge },
            { "x": 1.4, "y": 1.4, "z": 0.4, "w": 3.4, "d": 3.4, "h": 0.4, "tone": "wire", "edge": edge },
            { "x": 1.9, "y": 1.9, "z": 0.8, "w": 2.4, "d": 2.4, "h": 1.3, "fill": tone },
            { "x": 2.5, "y": 2.5, "z": 2.5, "w": 1.2, "d": 1.2, "h": 0.9, "tone": "wire", "edge": edge, "dash": "4 4" }
        ]
        view["grid"] = { "x0": 0.4, "y0": 0.4, "x1": 5.8, "y1": 5.8, "step": 0.8 }
        view["scale"] = 62.0
        view["oy"] = 96
    } else if kind == "links" {
        boxes = [
            { "x": 0.2, "y": 0.6, "z": 0, "w": 1.3, "d": 1.3, "h": 1.1, "tone": "wire", "edge": edge },
            { "x": 5.2, "y": 0.9, "z": 0, "w": 1.2, "d": 1.2, "h": 0.8, "tone": "wire", "edge": edge },
            { "x": 0.6, "y": 4.8, "z": 0, "w": 1.2, "d": 1.2, "h": 1.4, "tone": "wire", "edge": edge },
            { "x": 5.0, "y": 4.6, "z": 0, "w": 1.3, "d": 1.3, "h": 0.7, "tone": "wire", "edge": edge },
            { "x": 2.4, "y": 2.3, "z": 0, "w": 2.0, "d": 2.0, "h": 1.7, "fill": tone }
        ]
        view["grid"] = { "x0": 0, "y0": 0, "x1": 6.6, "y1": 6.6, "step": 0.8 }
        view["links"] = [
            { "a": { "x": 1.5, "y": 1.9, "z": 0.2 }, "b": { "x": 2.4, "y": 2.3, "z": 0.2 }, "colour": edge },
            { "a": { "x": 5.2, "y": 2.1, "z": 0.2 }, "b": { "x": 4.4, "y": 2.3, "z": 0.2 }, "colour": edge },
            { "a": { "x": 1.8, "y": 4.8, "z": 0.2 }, "b": { "x": 2.4, "y": 4.3, "z": 0.2 }, "colour": edge },
            { "a": { "x": 5.0, "y": 4.6, "z": 0.2 }, "b": { "x": 4.4, "y": 4.3, "z": 0.2 }, "colour": edge }
        ]
        view["scale"] = 58.0
        view["oy"] = 110
    } else if kind == "orbit" {
        boxes = [
            { "x": 2.3, "y": 2.2, "z": 0.3, "w": 2.2, "d": 2.2, "h": 1.8, "fill": tone },
            { "x": 0.4, "y": 3.0, "z": 0, "w": 0.8, "d": 0.8, "h": 0.4, "tone": "wire", "edge": edge },
            { "x": 5.6, "y": 1.4, "z": 0, "w": 0.8, "d": 0.8, "h": 0.4, "tone": "wire", "edge": edge },
            { "x": 4.6, "y": 5.6, "z": 0, "w": 0.8, "d": 0.8, "h": 0.4, "tone": "wire", "edge": edge },
            { "x": 0.8, "y": 1.0, "z": 0, "w": 0.8, "d": 0.8, "h": 0.4, "tone": "wire", "edge": edge }
        ]
        view["grid"] = { "x0": 0, "y0": 0, "x1": 6.8, "y1": 6.8, "step": 0.8 }
        view["links"] = [
            { "a": { "x": 1.2, "y": 3.4, "z": 0.1 }, "b": { "x": 2.3, "y": 3.3, "z": 0.1 }, "colour": edge },
            { "a": { "x": 5.6, "y": 1.8, "z": 0.1 }, "b": { "x": 4.5, "y": 2.4, "z": 0.1 }, "colour": edge },
            { "a": { "x": 4.6, "y": 5.6, "z": 0.1 }, "b": { "x": 4.5, "y": 4.4, "z": 0.1 }, "colour": edge },
            { "a": { "x": 1.2, "y": 1.4, "z": 0.1 }, "b": { "x": 2.3, "y": 2.2, "z": 0.1 }, "colour": edge }
        ]
        view["scale"] = 56.0
        view["oy"] = 112
    } else {
        boxes = [
            { "x": 1.2, "y": 1.2, "z": 0, "w": 4.2, "d": 4.2, "h": 3.4, "tone": "wire", "edge": edge, "dash": "5 5" },
            { "x": 2.4, "y": 2.4, "z": 0, "w": 1.8, "d": 1.8, "h": 1.5, "fill": tone }
        ]
        view["grid"] = { "x0": 0.4, "y0": 0.4, "x1": 6.2, "y1": 6.2, "step": 0.8 }
        view["scale"] = 66.0
        view["oy"] = 130
    }
    view["title"] = "An isometric diagram of the " + kind + " model"
    return iso_scene(boxes, view)
}

export fn sec_products() {
    let products = content_products()
    var out = '<section class="products" id="products"><div class="wrap">'
    out = out + '<div class="products-head">'
    out = out + '<h2 class="h2">Four parts.<br>No seams.</h2>'
    out = out + '<p class="products-note">Each one is usable alone. Together they close the loop between the shop floor and the ledger.</p>'
    out = out + '</div>'

    out = out + '<div class="products-body">'
    out = out + '<div class="rail" role="tablist" aria-label="Products">'
    var i = 0
    while i < len(products) {
        let p = products[i]
        var cls = 'rail-item'
        var sel = 'false'
        if i == 0 {
            cls = 'rail-item is-on'
            sel = 'true'
        }
        out = out + '<button class="' + cls + '" role="tab" id="prod-' + p["id"] + '" aria-controls="pane-' + p["id"] + '"'
        out = out + ' aria-selected="' + sel + '" data-product="' + p["id"] + '">'
        out = out + '<span class="rail-name">' + p["name"] + '</span>'
        out = out + '<span class="rail-full">' + p["full"] + '</span>'
        out = out + '</button>'
        i = i + 1
    }
    out = out + '</div><div class="panes">'

    i = 0
    while i < len(products) {
        let p = products[i]
        var hidden = ' hidden'
        if i == 0 {
            hidden = ''
        }
        out = out + '<div class="pane" id="pane-' + p["id"] + '" data-pane="' + p["id"] + '" role="tabpanel"'
        out = out + ' aria-labelledby="prod-' + p["id"] + '"' + hidden + '>'
        out = out + '<div class="pane-copy">'
        out = out + '<h3 class="pane-h">' + p["headline"] + '</h3>'
        out = out + '<p class="pane-body">' + p["body"] + '</p>'
        out = out + '<ul class="points">'
        var j = 0
        while j < len(p["points"]) {
            out = out + '<li>' + p["points"][j] + '</li>'
            j = j + 1
        }
        out = out + '</ul>'
        out = out + '<a class="link-arrow" href="#demo">See ' + p["name"] + ' in a live plant ' + arrow() + '</a>'
        out = out + '</div>'
        out = out + '<div class="pane-art">' + product_diagram(p["diagram"], "#2222f5", true) + '</div>'
        out = out + '</div>'
        i = i + 1
    }
    out = out + '</div></div></div></section>'
    return out
}

// ----------------------------------------------------------- the industries

fn industry_diagram(tone, dark) {
    var edge = "rgba(10,10,11,0.34)"
    var ink = "#141416"
    if dark {
        edge = "rgba(239,237,230,0.42)"
        ink = "#efede6"
    }
    let boxes = [
        { "x": 0.4, "y": 0.4, "z": 0, "w": 5.9, "d": 5.9, "h": 0.35, "tone": "wire", "edge": edge },
        { "x": 0.8, "y": 0.8, "z": 0.35, "w": 1.5, "d": 1.5, "h": 1.9, "fill": tone },
        { "x": 4.1, "y": 0.9, "z": 0.35, "w": 1.4, "d": 1.4, "h": 1.1, "fill": ink },
        { "x": 1.1, "y": 3.4, "z": 0.35, "w": 1.5, "d": 1.5, "h": 0.9, "tone": "wire", "edge": edge },
        { "x": 3.5, "y": 3.6, "z": 0.35, "w": 1.3, "d": 1.3, "h": 0.6, "fill": tone, "opacity": 0.65 },
        { "x": 5.2, "y": 3.2, "z": 0.35, "w": 1.0, "d": 1.0, "h": 0.8, "tone": "wire", "edge": edge, "dash": "4 4" }
    ]
    return iso_scene(boxes, {
        "w": 600,
        "h": 470,
        "scale": 46.0,
        "ox": 300,
        "oy": 118,
        "grid": { "x0": 0, "y0": 0, "x1": 6.6, "y1": 6.6, "step": 0.9 },
        "title": "An isometric diagram of the modules used in this industry"
    })
}

export fn sec_industries() {
    let industries = content_industries()
    var out = '<section class="industries" id="industries"><div class="wrap">'
    out = out + '<div class="industries-head">'
    out = out + '<h2 class="h2">Industry-focused,<br>without the fork.</h2>'
    out = out + '<p class="industries-note">One codebase, one model. The differences between sectors are configuration, not a separate product to license.</p>'
    out = out + '</div>'

    out = out + '<div class="tabs" role="tablist" aria-label="Industries">'
    var i = 0
    while i < len(industries) {
        let ind = industries[i]
        var cls = 'tab'
        var sel = 'false'
        if i == 0 {
            cls = 'tab is-on'
            sel = 'true'
        }
        out = out + '<button class="' + cls + '" role="tab" id="ind-' + ind["id"] + '" aria-controls="ipane-' + ind["id"] + '"'
        out = out + ' aria-selected="' + sel + '" data-industry="' + ind["id"] + '">' + ind["name"] + '</button>'
        i = i + 1
    }
    out = out + '</div>'

    out = out + '<div class="industry-panes">'
    i = 0
    while i < len(industries) {
        let ind = industries[i]
        var hidden = ' hidden'
        if i == 0 {
            hidden = ''
        }
        out = out + '<div class="industry-pane" id="ipane-' + ind["id"] + '" data-ipane="' + ind["id"] + '" role="tabpanel"'
        out = out + ' aria-labelledby="ind-' + ind["id"] + '"' + hidden + '>'
        out = out + '<div class="ind-copy"><p class="ind-body">' + ind["body"] + '</p>'
        out = out + '<ul class="chips">'
        var j = 0
        while j < len(ind["modules"]) {
            out = out + '<li>' + ind["modules"][j] + '</li>'
            j = j + 1
        }
        out = out + '</ul>'
        out = out + '<a class="link-arrow" href="#demo">See the ' + ind["name"].lower() + ' configuration ' + arrow() + '</a>'
        out = out + '</div>'
        out = out + '<div class="ind-art">' + industry_diagram(ind["tone"], false) + '</div>'
        out = out + '</div>'
        i = i + 1
    }
    out = out + '</div></div></section>'
    return out
}

// ----------------------------------------------------------------- the ask

export fn sec_demo() {
    var out = '<section class="demo" id="demo"><div class="wrap demo-in">'
    out = out + '<h2 class="demo-h">Bring the whole operation<br>into one system.</h2>'
    out = out + '<p class="demo-note">Tell us where the spreadsheets hurt. We will show you the same process running in Kiln, with your data.</p>'
    out = out + '<form class="demo-form" data-demo-form novalidate>'
    out = out + '<label class="field"><span class="field-label">Work email</span>'
    out = out + '<input type="email" name="email" placeholder="you@company.com" required autocomplete="email"></label>'
    out = out + '<button class="btn btn-fill" type="submit">Book a demo ' + arrow() + '</button>'
    out = out + '<p class="form-note" data-form-note role="status">A 30-minute call, no deck. We run your process, not ours.</p>'
    out = out + '</form>'
    out = out + '<div class="demo-meta"><span class="mono">Live in six weeks</span>'
    out = out + '<span class="mono">SOC 2 Type II</span><span class="mono">EU + US data residency</span></div>'
    out = out + '</div></section>'
    return out
}
