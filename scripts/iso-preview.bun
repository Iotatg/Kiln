import { iso_scene } from "../src/iso.bun"

let boxes = [
    { "x": 0.5, "y": 0.5, "z": 0, "w": 1.5, "d": 1.5, "h": 2.8, "tone": "wire", "id": "a" },
    { "x": 3.0, "y": 0.8, "z": 0, "w": 2.2, "d": 2.2, "h": 1.8, "fill": "#2222f5", "id": "b" },
    { "x": 6.0, "y": 0.5, "z": 0, "w": 1.0, "d": 1.0, "h": 1.2, "fill": "#f2c230", "id": "c" },
    { "x": 1.0, "y": 4.0, "z": 0, "w": 2.0, "d": 2.0, "h": 0.9, "fill": "#2b2b33", "id": "d" },
    { "x": 4.0, "y": 4.6, "z": 0, "w": 1.1, "d": 1.1, "h": 0.9, "fill": "#e8503a", "id": "e" },
    { "x": 6.4, "y": 4.2, "z": 0, "w": 1.1, "d": 1.1, "h": 0.5, "tone": "wire", "id": "f" }
]
let svg = iso_scene(boxes, {
    "w": 680, "h": 600, "scale": 42.0, "ox": 340, "oy": 250,
    "grid": { "x0": -0.4, "y0": -0.4, "x1": 7.6, "y1": 7.6, "step": 1 }
})
write_file("/tmp/iso.svg", svg)
print("ok " + str(len(svg)))
